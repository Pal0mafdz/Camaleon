# Copia este archivo a .env y ajusta lo que haga falta.

# Opción A — sqlite local, cada quien con sus propios datos:
DATABASE_URL=file:../../packages/db/local.db
# Opción B — BD compartida en Docker con los mismos datos que el resto del
# equipo (ver docker-compose.yml en la raíz + packages/db/Dockerfile):
#   docker compose up -d db
# DATABASE_URL=http://localhost:8080

CORS_ORIGIN=http://localhost:5174
NODE_ENV=development

GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
