{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.js"
  },
  "dependencies": {
    "@ai-sdk/devtools": "^1.0.12",
    "@ai-sdk/google": "^4.0.50",
    "@camaleon/db": "workspace:*",
    "@camaleon/env": "workspace:*",
    "ai": "catalog:",
    "dotenv": "catalog:",
    "hono": "^4.12.27",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@camaleon/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3"
  }
}
