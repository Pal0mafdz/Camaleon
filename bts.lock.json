    "apps/server/package.json": "{\n  \"name\": \"server\",\n  \"main\": \"src/index.ts\",\n  \"type\": \"module\",\n  \"scripts\": {\n    \"build\": \"tsdown\",\n    \"check-types\": \"tsc -b\",\n    \"compile\": \"bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server\",\n    \"dev\": \"bun run --hot src/index.ts\",\n    \"start\": \"bun run dist/index.js\"\n  },\n  \"dependencies\": {\n    \"dotenv\": \"catalog:\",\n    \"zod\": \"catalog:\",\n    \"@camaleon/env\": \"workspace:*\",\n    \"hono\": \"^4.12.27\",\n    \"ai\": \"catalog:\",\n    \"@ai-sdk/google\": \"^4.0.50\",\n    \"@ai-sdk/devtools\": \"^1.0.12\",\n    \"@camaleon/db\": \"workspace:*\"\n  },\n  \"devDependencies\": {\n    \"typescript\": \"^6.0.3\",\n    \"tsdown\": \"^0.22.3\",\n    \"@camaleon/config\": \"workspace:*\",\n    \"@types/bun\": \"catalog:\"\n  }\n}\n",
