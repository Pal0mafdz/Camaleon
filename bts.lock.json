    "package.json": "{\n  \"name\": \"camaleon\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"workspaces\": [\n    \"apps/*\",\n    \"packages/*\"\n  ],\n  \"scripts\": {\n    \"dev\": \"turbo dev\",\n    \"build\": \"turbo build\",\n    \"check-types\": \"turbo check-types\",\n    \"dev:web\": \"turbo -F web dev\",\n    \"dev:server\": \"turbo -F server dev\",\n    \"db:push\": \"turbo -F @camaleon/db db:push\",\n    \"db:studio\": \"turbo -F @camaleon/db db:studio\",\n    \"db:generate\": \"turbo -F @camaleon/db db:generate\",\n    \"db:migrate\": \"turbo -F @camaleon/db db:migrate\",\n    \"db:local\": \"turbo -F @camaleon/db db:local\"\n  },\n  \"packageManager\": \"pnpm@10.17.1\",\n  \"dependencies\": {\n    \"dotenv\": \"catalog:\",\n    \"zod\": \"catalog:\",\n    \"@camaleon/env\": \"workspace:*\"\n  },\n  \"devDependencies\": {\n    \"typescript\": \"^6.0.3\",\n    \"@types/bun\": \"catalog:\",\n    \"@camaleon/config\": \"workspace:*\",\n    \"turbo\": \"2.10.11\"\n  }\n}\n",
